# Local API port.
PORT=5000

# MongoDB connection string and a long random signing secret.
MONGO_URI=mongodb://127.0.0.1:27017/supportai
JWT_SECRET=replace-with-at-least-32-random-characters

# Google Identity Services Web OAuth client ID (same ID as client/.env)
GOOGLE_CLIENT_ID=

# Optional. When set together, the first admin user is created if it does not exist.
ADMIN_NAME=Support Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required for AI analysis; keep this value on the server only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set this to the exact Vercel frontend origin (no path); multiple origins may be comma-separated.
CLIENT_ORIGIN=http://localhost:5173
